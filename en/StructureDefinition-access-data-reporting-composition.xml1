  <differential>
    <element id="Composition">
      <path value="Composition"/>
      <constraint>
        <key value="access-data-reporting-composition-only-one-track-section"/>
        <severity value="error"/>
        <human value="The data reporting composition can include at most one track-based section (eCKM, CKM, MSK, BH)."/>
        <expression value="section.where(code.coding.where(system = 'https://dsacms.github.io/cmmi-access-model/CodeSystem/ACCESSTrackCS' and (code = 'eCKM' or code = 'CKM' or code = 'MSK' or code = 'BH')).exists()).count() &lt;= 1"/>
        <source value="https://dsacms.github.io/cmmi-access-model/StructureDefinition/access-data-reporting-composition|0.9.11"/>
      </constraint>
    </element>
    <element id="Composition.language">
      <path value="Composition.language"/>
      <binding>
        <strength value="preferred"/>
        <valueSet value="http://hl7.org/fhir/ValueSet/languages|4.0.1"/>
      </binding>
    </element>
    <element id="Composition.date">
      <path value="Composition.date"/>
      <mustSupport value="true"/>
    </element>
    <element id="Composition.author">
      <path value="Composition.author"/>
      <type>
        <code value="Reference"/>
        <targetProfile value="http://hl7.org/fhir/us/core/StructureDefinition/us-core-practitioner|6.1.0"/>
        <targetProfile value="http://hl7.org/fhir/us/core/StructureDefinition/us-core-practitionerrole|6.1.0"/>
      </type>
      <mustSupport value="true"/>
    </element>
    <element id="Composition.title">
      <path value="Composition.title"/>
