      <path value="Composition.section"/>
      <sliceName value="additional-information"/>
      <short value="Additional Information"/>
      <definition value="Optional section containing references to supplementary resources that provide additional context or detail beyond required track-specific data elements. All referenced resources must be included in the Bundle."/>
      <min value="0"/>
      <max value="1"/>
      <base>
        <path value="Composition.section"/>
