    </answer>
  </item>
  <item>
    <linkId value="odi-3"/>
    <text value="Lifting"/>
    <answer>
      <valueString value="Pain prevents me lifting heavy weights off the floor, but I can manage if they are conveniently placed e.g. on a table."/>
    </answer>
  </item>
  <item>
    <linkId value="odi-4"/>
    <text value="Walking"/>
    <answer>
      <valueString value="Pain prevents me from walking more than one mile."/>
    </answer>
  </item>
  <item>
    <linkId value="odi-5"/>
    <text value="Sitting"/>
    <answer>
      <valueString value="Pain prevents me from sitting for more than one hour."/>
    </answer>
  </item>
  <item>
    <linkId value="odi-6"/>
    <text value="Standing"/>
    <answer>
      <valueString value="Pain prevents me from standing for more than 1 hour."/>
    </answer>
  </item>
  <item>
    <linkId value="odi-7"/>
    <text value="Sleeping"/>
    <answer>
      <valueString value="My sleep is occasionally interrupted by pain."/>
    </answer>
  </item>
  <item>
    <linkId value="odi-8"/>
    <text value="Sex life (if applicable)"/>
    <answer>
      <valueString value="My sex life is nearly normal but is very painful."/>
    </answer>
  </item>
  <item>
    <linkId value="odi-9"/>
    <text value="Social life"/>
    <answer>
      <valueString value="Pain has restricted my social life and I do not go out as often."/>
    </answer>
  </item>
  <item>
    <linkId value="odi-10"/>
    <text value="Traveling"/>
    <answer>
      <valueString value="Pain is bad but I am able to manage trips over two hours."/>
